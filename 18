/*Ejercicio 18. Obtener la primera posición de un valor
Enunciado. Leer 10 enteros y un valor X. Mostrar el primer índice donde aparece; si no existe,
mostrar -1.*/



#include <iostream>
using namespace std;

int main()
{
    int A[10];
    int X;
    int posicion = -1;

    for(int i = 0; i < 10; i++)
    {
        cin >> A[i];
    }

    cout<<"Ingrese un numero:";
    cin >> X;

    for(int i = 0; i < 10; i++)
    {
        if(A[i] == X && posicion == -1)
        {
            posicion = i;
        }
    }

    cout << "Primera posición = " << posicion;

    return 0;
}
