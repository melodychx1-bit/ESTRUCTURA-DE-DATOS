/*Ejercicio 9. Contar pares
Enunciado. Leer 10 enteros y contar cuántos son pares.*/



#include <iostream>
using namespace std;

int main() {
    int numeros[10];
    int pares = 0;

    for (int i = 0; i < 10; i++) {
        cin >> numeros[i];

        if (numeros[i] % 2 == 0) {
            pares = pares + 1;
        }
    }

    cout << "Pares = " << pares;

    return 0;
}
