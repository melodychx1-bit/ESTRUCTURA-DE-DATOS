
/*Ejercicio 51. Unión sin duplicados
Enunciado. Dados A y B, construir C con todos los valores distintos que aparezcan en 
cualquiera de los dos
arreglos.*/

#include <iostream>
using namespace std;

int main() {
    int nA, nB;

    cout << "Ingrese el tamaño de A: ";
    cin >> nA;

    int A[100];

    cout << "Ingrese los elementos de A: ";
    for (int i = 0; i < nA; i++) {
        cin >> A[i];
    }

    cout << "Ingrese el tamaño de B: ";
    cin >> nB;

    int B[100];

    cout << "Ingrese los elementos de B: ";
    for (int i = 0; i < nB; i++) {
        cin >> B[i];
    }

    int C[200];
    int nC = 0;

   
    for (int i = 0; i < nA; i++) {

        bool existe = false;

        for (int j = 0; j < nC; j++) {
            if (C[j] == A[i]) {
                existe = true;
            }
        }

        if (!existe) {
            C[nC] = A[i];
            nC++;
        }
    }


    for (int i = 0; i < nB; i++) {

        bool existe = false;

        for (int j = 0; j < nC; j++) {
            if (C[j] == B[i]) {
                existe = true;
            }
        }

        if (!existe) {
            C[nC] = B[i];
            nC++;
        }
    }

    cout << "Union: ";

    for (int i = 0; i < nC; i++) {
        cout << C[i] << " ";
    }

    cout << endl;

    return 0;
}
