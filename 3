/*Ejercicio 3. Sumar todos los elementos
Enunciado. Leer 5 enteros y calcular la suma total de sus elementos.*/

#include <iostream>
using namespace std;

int main() {
    int numeros[5];
    int suma = 0;

    for (int i = 0; i < 5; i++) {
        cin >> numeros[i];
        suma = suma + numeros[i];
    }

    cout << "La suma total es:"<<suma;

    return 0;
}
