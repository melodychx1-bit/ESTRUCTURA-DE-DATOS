/*Ejercicio 36. Eliminar duplicados conservando primera aparición
Enunciado. Construir el resultado sin valores repetidos y respetando la 
primera aparición de cada elemento*/

#include <iostream>
using namespace std;

int main() {

    int numeros[50];
    int N;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;

    cout << "Ingrese los " << N << " numeros: ";
    for (int i = 0; i < N; i++) {
        cin >> numeros[i];
    }

   
    for (int i = 0; i < N; i++) {

        for (int j = i + 1; j < N; j++) {

            if (numeros[i] == numeros[j]) {

                
                for (int k = j; k < N - 1; k++) {
                    numeros[k] = numeros[k + 1];
                }

                N--;
                j--;
            }
        }
    }

    cout << "Arreglo sin duplicados: ";

    for (int i = 0; i < N; i++) {
        cout << numeros[i] << " ";
    }

    return 0;
}

