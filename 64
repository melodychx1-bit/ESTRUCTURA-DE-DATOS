/*Ejercicio 64. Partición alrededor de un pivote
Enunciado. Dado X, reorganizar el arreglo de modo que primero queden valores
menores que X, luego iguales y
después mayores.*/


#include <iostream>
using namespace std;

int main() {
    int n, x;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos: ";
    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    cout << "Ingrese X: ";
    cin >> x;

    int aux[100];
    int posicion = 0;


    for (int i = 0; i < n; i++) {
        if (v[i] < x) {
            aux[posicion] = v[i];
            posicion++;
        }
    }

  
    for (int i = 0; i < n; i++) {
        if (v[i] == x) {
            aux[posicion] = v[i];
            posicion++;
        }
    }

    
    for (int i = 0; i < n; i++) {
        if (v[i] > x) {
            aux[posicion] = v[i];
            posicion++;
        }
    }

    cout << "Arreglo particionado: ";

    for (int i = 0; i < n; i++) {
        cout << aux[i] << " ";
    }

    return 0;
}
