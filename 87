/*Ejercicio 87. Elemento mayoritario
Enunciado. Determinar si existe un valor que aparezca más de N/2 veces. 
Implementar Boyer-Moore y verificar
el candidato.*/


#include <iostream>
using namespace std;

int main() {

    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos: ";

    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

  

    int candidato = 0;
    int contador = 0;

    for (int i = 0; i < n; i++) {

        if (contador == 0) {

            candidato = v[i];
            contador = 1;

        } else if (v[i] == candidato) {

            contador++;

        } else {

            contador--;
        }
    }


    int frecuencia = 0;

    for (int i = 0; i < n; i++) {

        if (v[i] == candidato) {
            frecuencia++;
        }
    }


    if (frecuencia > n / 2) {

        cout << "Mayoritario = " << candidato;

    } else {

        cout << "No existe elemento mayoritario.";
    }

    return 0;
}
