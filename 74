/*Ejercicio 74. Consultas de suma por rango
Enunciado. Construir prefijos y responder Q consultas [L,R] en O(1) por consulta 
después del preprocesamiento.*/


#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];
    int prefijos[100];

    cout << "Ingrese los elementos: ";

    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }


    prefijos[0] = v[0];

    for (int i = 1; i < n; i++) {
        prefijos[i] = prefijos[i - 1] + v[i];
    }

    int q;

    cout << "Ingrese Q: ";
    cin >> q;

    for (int i = 0; i < q; i++) {

        int L, R;

        cout << "Ingrese L y R: ";
        cin >> L >> R;

        int suma;

        if (L == 0) {
            suma = prefijos[R];
        } else {
            suma = prefijos[R] - prefijos[L - 1];
        }

        cout << "Suma = " << suma << endl;
    }

    return 0;
}
