/*Ejercicio 59. Detectar palíndromo numérico
Enunciado. Determinar si el arreglo se lee igual de izquierda a derecha y de 
derecha a izquierda*/

#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos: ";
    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    bool palindromo = true;

    for (int i = 0; i < n / 2; i++) {

        if (v[i] != v[n - 1 - i]) {
            palindromo = false;
            break;
        }
    }

    if (palindromo) {
        cout << "Palindromo: SI" << endl;
    }
    else {
        cout << "Palindromo: NO" << endl;
    }

    return 0;
}
