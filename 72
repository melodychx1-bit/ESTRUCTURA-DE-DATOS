/*Ejercicio 72. Equilibrio izquierda-derecha
Enunciado. Encontrar un índice i cuya suma de elementos a la izquierda sea igual a la
suma de elementos a la
derecha.*/


#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos: ";
    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

 
    int sumaTotal = 0;

    for (int i = 0; i < n; i++) {
        sumaTotal += v[i];
    }

    int sumaIzquierda = 0;
    int indiceEquilibrio = -1;

    for (int i = 0; i < n; i++) {

       
        int sumaDerecha = sumaTotal - sumaIzquierda - v[i];

        if (sumaIzquierda == sumaDerecha) {
            indiceEquilibrio = i;
            break;
        }

       
        sumaIzquierda += v[i];
    }

    if (indiceEquilibrio != -1) {
        cout << "Indice de equilibrio = "
             << indiceEquilibrio;
    } else {
        cout << "No existe indice de equilibrio.";
    }

    return 0;
}
