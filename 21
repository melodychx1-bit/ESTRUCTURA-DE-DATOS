/*Ejercicio 21. Intercambiar primero y último
Enunciado. Leer N enteros (2 ≤ N ≤ 50), intercambiar el primer elemento con el
último y mostrar el arreglo*/


#include <iostream>
using namespace std;

int main()
{
    int A[50];
    int N;
    int aux;
    
    cout<<"Ingrese un numero:";
    cin >> N;

    for(int i = 0; i < N; i++)
    {
        cin >> A[i];
    }

    aux = A[0];
    A[0] = A[N - 1];
    A[N - 1] = aux;

    for(int i = 0; i < N; i++)
    {
        cout << A[i] << " ";
    }

    return 0;
}
