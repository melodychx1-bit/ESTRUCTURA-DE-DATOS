/*Ejercicio 12. Elevar al cuadrado
Enunciado. Leer 5 enteros y crear un segundo arreglo con el cuadrado de cada valor*/


#include <iostream>
using namespace std;

int main()
{
    int A[5];
    int B[5];

    for(int i = 0; i < 5; i++)
    {
        cin >> A[i];
    }

    for(int i = 0; i < 5; i++)
    {
        B[i] = A[i] * A[i];
    }

    for(int i = 0; i < 5; i++)
    {
        cout << B[i] << " ";
    }

    return 0;
}
