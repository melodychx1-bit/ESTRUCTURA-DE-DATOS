/*Ejercicio 40. Comparar dos vectores
Enunciado. Determinar si dos arreglos de igual tamaño contienen exactamente los mismos valores en las mismas
posiciones.*/

#include <iostream>
using namespace std;

int main() {
    int A[50];
    int B[50];
    int N;
    bool iguales = true;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;

    cout << "Ingrese los " << N << " numeros del arreglo A: ";
    for (int i = 0; i < N; i++) {
        cin >> A[i];
    }

    cout << "Ingrese los " << N << " numeros del arreglo B: ";
    for (int i = 0; i < N; i++) {
        cin >> B[i];
    }

    for (int i = 0; i < N; i++) {
        if (A[i] != B[i]) {
            iguales = false;
        }
    }

    if (iguales) {
        cout << "Iguales: SI";
    } else {
        cout << "Iguales: NO";
    }

    return 0;
}
