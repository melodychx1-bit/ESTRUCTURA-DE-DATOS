/*Ejercicio 15. Sumar posiciones impares
Enunciado. Leer 8 enteros y sumar los elementos ubicados en índices impares: 1, 3, 5, 7*/


#include <iostream>
using namespace std;

int main()
{
    int A[8];
    int suma = 0;

    for(int i = 0; i < 8; i++)
    {
        cin >> A[i];
    }

    for(int i = 0; i < 8; i++)
    {
        if(i % 2 != 0)
        {
            suma = suma + A[i];
        }
    }

    cout << "Suma indices impares = " << suma;

    return 0;
}
