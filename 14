/*Ejercicio 14. Sumar posiciones pares
Enunciado. Leer 8 enteros y sumar los elementos ubicados en índices pares: 0, 2, 4, 6*/


#include <iostream>
using namespace std;

int main()
{
    int A[8];
    int suma = 0;

    for(int i = 0; i < 8; i++)
    {
        cin >> A[i];
    }

    for(int i = 0; i < 8; i++)
    {
        if(i % 2 == 0)
        {
            suma = suma + A[i];
        }
    }

    cout << "Suma indices pares = " << suma;

    return 0;
}
