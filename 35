/*Ejercicio 35. Compactar ceros al final
Enunciado. Mover todos los valores cero al final manteniendo el orden relativo de los no-cero.*/



#include <iostream>
using namespace std;

int main() {

    int numeros[50];
    int N;
    int posicion = 0;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;

    cout << "Ingrese los " << N << " numeros: ";
    for (int i = 0; i < N; i++) {
        cin >> numeros[i];
    }

    for (int i = 0; i < N; i++) {

        if (numeros[i] != 0) {
            numeros[posicion] = numeros[i];
            posicion++;
        }
    }

    while (posicion < N) {
        numeros[posicion] = 0;
        posicion++;
    }

    cout << "Arreglo con los ceros al final: ";

    for (int i = 0; i < N; i++) {
        cout << numeros[i] << " ";
    }

    return 0;
}

