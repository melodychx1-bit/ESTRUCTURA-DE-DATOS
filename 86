/*Ejercicio 86. Contar X con dos búsquedas binarias
Enunciado. Contar cuántas veces aparece X en un arreglo ordenado usando primera y 
última aparición, con
complejidad O(log N).*/


#include <iostream>
using namespace std;

int primeraAparicion(int v[], int n, int x) {

    int izquierda = 0;
    int derecha = n - 1;
    int respuesta = -1;

    while (izquierda <= derecha) {

        int medio = (izquierda + derecha) / 2;

        if (v[medio] == x) {

            respuesta = medio;
            derecha = medio - 1;

        } else if (v[medio] < x) {

            izquierda = medio + 1;

        } else {

            derecha = medio - 1;
        }
    }

    return respuesta;
}

int ultimaAparicion(int v[], int n, int x) {

    int izquierda = 0;
    int derecha = n - 1;
    int respuesta = -1;

    while (izquierda <= derecha) {

        int medio = (izquierda + derecha) / 2;

        if (v[medio] == x) {

            respuesta = medio;
            izquierda = medio + 1;

        } else if (v[medio] < x) {

            izquierda = medio + 1;

        } else {

            derecha = medio - 1;
        }
    }

    return respuesta;
}

int main() {

    int n, x;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos ordenados: ";

    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    cout << "Ingrese X: ";
    cin >> x;

    int primera = primeraAparicion(v, n, x);
    int ultima = ultimaAparicion(v, n, x);

    if (primera == -1) {

        cout << "Cantidad = 0";

    } else {

        int cantidad = ultima - primera + 1;

        cout << "Cantidad = " << cantidad;
    }

    return 0;
}
