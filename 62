/*Ejercicio 62. Rotación K posiciones a la izquierda
Enunciado. Rotar un arreglo K posiciones a la izquierda, normalizando K con módulo N.*/

#include <iostream>
using namespace std;

int main() {
    int n, k;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos: ";
    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    cout << "Ingrese K: ";
    cin >> k;


    k = k % n;

    int aux[100];


    for (int i = 0; i < n - k; i++) {
        aux[i] = v[i + k];
    }


    for (int i = 0; i < k; i++) {
        aux[n - k + i] = v[i];
    }


    for (int i = 0; i < n; i++) {
        v[i] = aux[i];
    }

    cout << "Arreglo rotado: ";

    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }

    return 0;
}
