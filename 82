/*Ejercicio 82. Merge Sort con arreglos
Enunciado. Implementar Merge Sort usando un arreglo auxiliar temporal y fusión manual*/

#include <iostream>
using namespace std;

void mezclar(int v[], int aux[], int inicio, int medio, int fin) {

    int i = inicio;
    int j = medio + 1;
    int k = inicio;

    while (i <= medio && j <= fin) {

        if (v[i] <= v[j]) {
            aux[k] = v[i];
            i++;
        } else {
            aux[k] = v[j];
            j++;
        }

        k++;
    }

    
    while (i <= medio) {
        aux[k] = v[i];
        i++;
        k++;
    }

   
    while (j <= fin) {
        aux[k] = v[j];
        j++;
        k++;
    }

 
    for (int x = inicio; x <= fin; x++) {
        v[x] = aux[x];
    }
}

void mergeSort(int v[], int aux[], int inicio, int fin) {

    if (inicio < fin) {

        int medio = (inicio + fin) / 2;

      
        mergeSort(v, aux, inicio, medio);

  
        mergeSort(v, aux, medio + 1, fin);

      
        mezclar(v, aux, inicio, medio, fin);
    }
}

int main() {

    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];
    int aux[100];

    cout << "Ingrese los elementos: ";

    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    mergeSort(v, aux, 0, n - 1);

    cout << "Arreglo ordenado: ";

    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }

    return 0;
}
