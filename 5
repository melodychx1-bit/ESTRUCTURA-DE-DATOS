/*Ejercicio 5. Encontrar el mayor
Enunciado. Leer 7 enteros y determinar el valor mayor*/

#include <iostream>
using namespace std;

int main() {
    int numeros[7];
    int mayor;

    for (int i = 0; i < 7; i++) {
        cin >> numeros[i];
    }

    mayor = numeros[0];

    for (int i = 1; i < 7; i++) {
        if (numeros[i] > mayor) {
            mayor = numeros[i];
        }
    }

    cout << "Mayor = " << mayor;

    return 0;
}
