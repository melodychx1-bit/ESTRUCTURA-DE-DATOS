//Ejercicio 1. Leer y mostrar un vector
//Enunciado.Leer 5 números enteros en un arreglo y mostrarlos en el mismo orden.
#include <iostream>
    using namespace std;

    int main()
    {
        int numeros[5];

        for (int i = 0; i < 5; i++)
        {
            cin >> numeros[i];
        }

        for (int i = 0; i < 5; i++)
        {
            cout << numeros[i] << " ";
        }

        return 0;
    }
