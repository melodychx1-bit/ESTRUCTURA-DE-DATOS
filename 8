/*Ejercicio 8. Contar números negativos
Enunciado. Leer 8 enteros y contar cuántos son menores que cero.*/


#include <iostream>
using namespace std;

int main() {
    int numeros[8];
    int negativos = 0;

    for (int i = 0; i < 8; i++) {
        cin >> numeros[i];

        if (numeros[i] < 0) {
            negativos = negativos + 1;
        }
    }

    cout << "Negativos = " << negativos;

    return 0;
}
