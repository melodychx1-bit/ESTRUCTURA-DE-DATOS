/*Ejercicio 19. Contar apariciones de un valor
Enunciado. Leer 10 enteros y un valor X. Contar cuántas veces aparece X.*/



#include <iostream>
using namespace std;

int main()
{
    int A[10];
    int X;
    int contador = 0;

    for(int i = 0; i < 10; i++)
    {
        cin >> A[i];
    }
    
    cout<<"Ingrese un numero:";
    cin >> X;

    for(int i = 0; i < 10; i++)
    {
        if(A[i] == X)
        {
            contador = contador + 1;
        }
    }

    cout << "Apariciones = " << contador;

    return 0;
}
