/*Ejercicio 73. Prefijos acumulados
Enunciado. Construir P donde P[i] contiene la suma de A[0] hasta A[i].*/

#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];
    int prefijos[100];

    cout << "Ingrese los elementos: ";

    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

  
    prefijos[0] = v[0];


    for (int i = 1; i < n; i++) {
        prefijos[i] = prefijos[i - 1] + v[i];
    }

    cout << "Prefijos: ";

    for (int i = 0; i < n; i++) {
        cout << prefijos[i] << " ";
    }

    return 0;
}
