/*Ejercicio 22. Rotar una posición a la derecha
Enunciado. Desplazar todos los elementos una posición a la derecha; el último pasa
a la primera posición*/


#include <iostream>
using namespace std;

int main()
{
    int A[50];
    int N;
    int aux;
    
    cout<<"Ingrese un numero:";
    cin >> N;

    for(int i = 0; i < N; i++)
    {
        cin >> A[i];
    }

    aux = A[N - 1];

    for(int i = N - 1; i > 0; i--)
    {
        A[i] = A[i - 1];
    }

    A[0] = aux;

    for(int i = 0; i < N; i++)
    {
        cout << A[i] << " ";
    }

    return 0;
}
