/*Ejercicio 43. Ordenamiento por selección
Enunciado. Ordenar N enteros ascendentemente con Selection Sort.*/

#include <iostream>
using namespace std;

int main() {
    int numeros[50];
    int N;
    int posicionMenor;
    int aux;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;

    cout << "Ingrese los " << N << " numeros: ";
    for (int i = 0; i < N; i++) {
        cin >> numeros[i];
    }

    for (int i = 0; i < N - 1; i++) {
        posicionMenor = i;

        for (int j = i + 1; j < N; j++) {
            if (numeros[j] < numeros[posicionMenor]) {
                posicionMenor = j;
            }
        }

        aux = numeros[i];
        numeros[i] = numeros[posicionMenor];
        numeros[posicionMenor] = aux;
    }

    cout << "Arreglo ordenado de menor a mayor: ";

    for (int i = 0; i < N; i++) {
        cout << numeros[i] << " ";
    }

    return 0;
}
