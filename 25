/*Ejercicio 25. Sumar dos vectores
Enunciado. Leer dos arreglos A y B de igual tamaño y generar C donde C[i] = A[i] + B[i]*/


#include <iostream>
using namespace std;

int main() {

    int A[50];
    int B[50];
    int C[50];
    int N;

    cout<<"Ingrese un numero:";
    cin >> N;

    
    for (int i = 0; i < N; i++) {
        cout<<"Ingrese los numeros para A:";
        cin >> A[i];
    }

  
    for (int i = 0; i < N; i++) {
         cout<<"Ingrese los numeros para B:";
        cin >> B[i];
    }

  
    for (int i = 0; i < N; i++) {
        C[i] = A[i] + B[i];
    }

  
    for (int i = 0; i < N; i++) {
        cout << C[i] << " ";
    }

    return 0;
}

