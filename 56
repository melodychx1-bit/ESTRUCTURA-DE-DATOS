/*Ejercicio 56. Contar cambios de signo
Enunciado. Contar cuántas veces dos elementos consecutivos no cero tienen signos diferentes.*/

#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Ingrese N: ";
    cin >> n;

    int v[100];

    cout << "Ingrese los elementos: ";
    for (int i = 0; i < n; i++) {
        cin >> v[i];
    }

    int cambios = 0;

    for (int i = 0; i < n - 1; i++) {

        if (v[i] != 0 && v[i + 1] != 0) {

            if ((v[i] > 0 && v[i + 1] < 0) ||
                (v[i] < 0 && v[i + 1] > 0)) {

                cambios++;
            }
        }
    }

    cout << "Cambios de signo = " << cambios << endl;

    return 0;
}
