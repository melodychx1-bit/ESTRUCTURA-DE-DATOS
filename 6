/*Ejercicio 6. Encontrar el menor
Enunciado. Leer 7 enteros y determinar el valor menor.*/

#include <iostream>
using namespace std;

int main() {
    int numeros[7];
    int menor;

    for (int i = 0; i < 7; i++) {
        cin >> numeros[i];
    }

    menor = numeros[0];

    for (int i = 1; i < 7; i++) {
        if (numeros[i] < menor) {
            menor = numeros[i];
        }
    }

    cout << "Menor = " << menor;

    return 0;
}
