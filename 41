/*Ejercicio 41. Ordenamiento burbuja ascendente
Enunciado. Ordenar N enteros de menor a mayor implementando Bubble Sort manualmente*/

#include <iostream>
using namespace std;

int main() {
    int numeros[50];
    int N;
    int aux;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;

    cout << "Ingrese los " << N << " numeros: ";
    for (int i = 0; i < N; i++) {
        cin >> numeros[i];
    }

    for (int i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - 1 - i; j++) {
            if (numeros[j] > numeros[j + 1]) {
                aux = numeros[j];
                numeros[j] = numeros[j + 1];
                numeros[j + 1] = aux;
            }
        }
    }

    cout << "Arreglo ordenado de menor a mayor: ";

    for (int i = 0; i < N; i++) {
        cout << numeros[i] << " ";
    }

    return 0;
}
